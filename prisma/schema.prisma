generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String             @id @default(uuid())
  username                  String             @unique
  email                     String             @unique
  password_hash             String
  createdAt                 DateTime           @default(now())
  lastSeenAt                DateTime           @default(now())
  readReceiptsOn            Boolean            @default(true)
  avatarFileKey             String?
  messages                  Message[]
  scheduledMessages         ScheduledMessage[]
  participants              Participant[]
  refreshSessions           RefreshSession[]
  administeredConversations Conversation[]     @relation("ConversationAdmin")
}

model RefreshSession {
  /// Ham refresh token hiçbir zaman veritabanına yazılmaz; yalnızca HMAC özeti tutulur.
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Conversation {
  id                String             @id @default(uuid())
  isGroup           Boolean            @default(false)
  name              String?
  adminId           String?
  createdAt         DateTime           @default(now())
  pinnedByIds       String[]           @default([])
  archivedByIds     String[]           @default([])
  mutedByIds        String[]           @default([])
  disappearingDurationSeconds Int?
  admin             User?              @relation("ConversationAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  messages          Message[]
  scheduledMessages ScheduledMessage[]
  participants      Participant[]

  @@index([adminId])
}

model Participant {
  id             String       @id @default(uuid())
  userId         String
  conversationId String
  joinedAt       DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([conversationId])
}

model Message {
  id             String       @id @default(uuid())
  content        String
  senderId       String
  conversationId String
  clientId       String?
  createdAt      DateTime     @default(now())
  expiresAt       DateTime?
  editedAt       DateTime?
  readByIds      String[]     @default([])
  isPinned       Boolean      @default(false)
  isForwarded    Boolean      @default(false)
  starredByIds   String[]     @default([])
  deletedForIds  String[]     @default([])
  fileKey        String?
  fileType       String?
  fileName       String?
  replyToId      String?
  replyTo        Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("MessageReplies")
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt])
  @@index([expiresAt])
  @@index([senderId])
}

model ScheduledMessage {
  id             String       @id @default(uuid())
  content        String
  senderId       String
  conversationId String
  clientId       String?
  sendAt         DateTime
  createdAt      DateTime     @default(now())
  fileKey        String?
  fileType       String?
  fileName       String?
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientId])
  @@index([sendAt])
  @@index([conversationId, senderId])
}
