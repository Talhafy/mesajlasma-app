generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String             @id @default(uuid())
  username                  String             @unique
  email                     String             @unique
  password_hash             String
  createdAt                 DateTime           @default(now())
  lastSeenAt                DateTime           @default(now())
  readReceiptsOn            Boolean            @default(true)
  avatarFileKey             String?
  failedLoginAttempts       Int                @default(0)
  messages                  Message[]
  scheduledMessages         ScheduledMessage[]
  participants              Participant[]
  refreshSessions           RefreshSession[]
  administeredConversations Conversation[]     @relation("ConversationAdmin")
  blockedUsers              BlockedUser[]      @relation("BlockedBy")
  blockedByUsers            BlockedUser[]      @relation("Blocks")
  messageReads              MessageRead[]
  messageStars              MessageStar[]
  messageDeletions          MessageDeletion[]
  uploadedAssets            UploadedAsset[]
  conversationReadStates    ConversationReadState[]
}

enum UploadedAssetStatus {
  QUARANTINE
  READY
  ATTACHED
  REJECTED
}

model UploadedAsset {
  id           String              @id @default(uuid())
  fileKey      String              @unique
  ownerId      String
  mimeType     String
  sizeBytes    Int
  checksum     String
  status       UploadedAssetStatus @default(QUARANTINE)
  expiresAt    DateTime?
  attachedAt   DateTime?
  createdAt    DateTime            @default(now())
  owner        User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@index([status, expiresAt])
}

model BlockedUser {
  userId    String
  blockedId String
  createdAt DateTime @default(now())
  user      User     @relation("BlockedBy", fields: [userId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocks", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([userId, blockedId])
  @@index([blockedId])
}

model RefreshSession {
  /// Ham refresh token hiçbir zaman veritabanına yazılmaz; yalnızca HMAC özeti tutulur.
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Conversation {
  id                String             @id @default(uuid())
  isGroup           Boolean            @default(false)
  name              String?
  adminId           String?
  avatarFileKey     String?
  adminHistory      String             @default("")
  createdAt         DateTime           @default(now())
  disappearingDurationSeconds Int?
  isDeleted         Boolean            @default(false)
  admin             User?              @relation("ConversationAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  messages          Message[]
  scheduledMessages ScheduledMessage[]
  participants      Participant[]
  readStates        ConversationReadState[]

  @@index([adminId])
}

model Participant {
  id             String       @id @default(uuid())
  userId         String
  conversationId String
  joinedAt       DateTime     @default(now())
  isPinned       Boolean      @default(false)
  isArchived     Boolean      @default(false)
  isMuted        Boolean      @default(false)
  isActive       Boolean      @default(true)
  leftAt         DateTime?
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([conversationId])
}

model Message {
  id             String       @id @default(uuid())
  content        String
  senderId       String
  conversationId String
  clientId       String?
  createdAt      DateTime     @default(now())
  expiresAt      DateTime?
  editedAt       DateTime?
  reads          MessageRead[]
  stars          MessageStar[]
  deletions      MessageDeletion[]
  isPinned       Boolean      @default(false)
  isForwarded    Boolean      @default(false)
  fileKey        String?
  fileType       String?
  fileName       String?
  replyToId      String?
  replyTo        Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("MessageReplies")
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([expiresAt])
  @@index([senderId])
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin, map: "Message_content_trgm_idx")
}

model MessageRead {
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, messageId])
}

// Bir kullanıcının sohbet başına son okuma imleci. Her mesaj için MessageRead satırı
// oluşturmak yerine sabit sayıda durum kaydı tutulur.
model ConversationReadState {
  id                String       @id @default(uuid())
  userId            String
  conversationId    String
  lastReadAt        DateTime
  lastReadMessageId String?
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([conversationId, lastReadAt])
}

model ScheduledMessage {
  id             String       @id @default(uuid())
  content        String
  senderId       String
  conversationId String
  clientId       String?
  sendAt         DateTime
  createdAt      DateTime     @default(now())
  fileKey        String?
  fileType       String?
  fileName       String?
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientId])
  @@index([sendAt])
  @@index([conversationId, senderId])
}

model MessageStar {
  messageId String
  userId    String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, messageId])
}

model MessageDeletion {
  messageId String
  userId    String
  deletedAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, messageId])
}
