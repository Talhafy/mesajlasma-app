generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String             @id @default(uuid())
  username                  String             @unique
  email                     String             @unique
  password_hash             String
  createdAt                 DateTime           @default(now())
  lastSeenAt                DateTime           @default(now())
  readReceiptsOn            Boolean            @default(true)
  avatarFileKey             String?
  failedLoginAttempts       Int                @default(0)
  messages                  Message[]
  participants              Participant[]
  refreshSessions           RefreshSession[]
  administeredConversations Conversation[]     @relation("ConversationAdmin")
  blockedUsers              BlockedUser[]      @relation("BlockedBy")
  blockedByUsers            BlockedUser[]      @relation("Blocks")
  messageReads              MessageRead[]
  messageStars              MessageStar[]
  messageDeletions          MessageDeletion[]
  uploadedAssets            UploadedAsset[]
  conversationReadStates    ConversationReadState[]
  devices                   UserDevice[]
  historyBackup             EncryptedHistoryBackup?
  accountHistoryKey         AccountHistoryKey?
  accountHistoryMessages    AccountHistoryMessage[]
}

model AccountHistoryKey {
  userId     String @id
  salt       String
  iv         String
  wrappedKey String
  publicKey  String
  inboxIv    String
  inboxKey   String
  revision   Int    @default(1)
  vaultApproval Json?
  vaultRecovery Json?
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AccountHistoryMessage {
  userId    String
  messageId String
  version   String
  iv        String
  payload   String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, messageId, version])
  @@index([messageId])
}

enum UploadedAssetStatus {
  QUARANTINE
  READY
  ATTACHED
  REJECTED
}

model UploadedAsset {
  id           String              @id @default(uuid())
  fileKey      String              @unique
  ownerId      String
  mimeType     String
  sizeBytes    Int
  checksum     String
  status       UploadedAssetStatus @default(QUARANTINE)
  expiresAt    DateTime?
  attachedAt   DateTime?
  createdAt    DateTime            @default(now())
  owner        User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@index([status, expiresAt])
}

model BlockedUser {
  userId    String
  blockedId String
  createdAt DateTime @default(now())
  user      User     @relation("BlockedBy", fields: [userId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocks", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([userId, blockedId])
  @@index([blockedId])
}

model RefreshSession {
  /// Ham refresh token hiçbir zaman veritabanına yazılmaz; yalnızca HMAC özeti tutulur.
  id        String    @id @default(uuid())
  userId    String
  sessionId String    @default(uuid())
  deviceId  String?
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  device    UserDevice? @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([sessionId])
  @@index([deviceId])
}

model Conversation {
  id                String             @id @default(uuid())
  isGroup           Boolean            @default(false)
  name              String?
  adminId           String?
  avatarFileKey     String?
  adminHistory      String             @default("")
  createdAt         DateTime           @default(now())
  disappearingDurationSeconds Int?
  isDeleted         Boolean            @default(false)
  mlsCurrentEpoch   Int                @default(0)
  mlsGroupId        String?            @unique
  admin             User?              @relation("ConversationAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  messages          Message[]
  participants      Participant[]
  readStates        ConversationReadState[]
  mlsCommits        MlsCommit[]
  mlsWelcomes       MlsWelcome[]

  @@index([adminId])
}

model Participant {
  id             String       @id @default(uuid())
  userId         String
  conversationId String
  joinedAt       DateTime     @default(now())
  isPinned       Boolean      @default(false)
  isArchived     Boolean      @default(false)
  isMuted        Boolean      @default(false)
  isActive       Boolean      @default(true)
  leftAt         DateTime?
  historyClearedAt DateTime?
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  historyPeriods ParticipantHistoryPeriod[]

  @@unique([userId, conversationId])
  @@index([conversationId])
}

model ParticipantHistoryPeriod {
  participantId String
  joinedAt      DateTime
  leftAt        DateTime
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@id([participantId, joinedAt])
}

model Message {
  id             String       @id @default(uuid())
  content        String
  senderId       String
  conversationId String
  clientId       String?
  createdAt      DateTime     @default(now())
  expiresAt      DateTime?
  editedAt       DateTime?
  reads          MessageRead[]
  stars          MessageStar[]
  deletions      MessageDeletion[]
  accountHistory AccountHistoryMessage[]
  historyDelivery Json?
  isPinned       Boolean      @default(false)
  isForwarded    Boolean      @default(false)
  protocolVersion Int         @default(0)
  epoch          Int?
  senderDeviceId String?
  ciphertext     String?
  encryptedFileMetadata String?
  messageType    String       @default("text")
  isDeletedForEveryone Boolean @default(false)
  fileKey        String?
  fileType       String?
  fileName       String?
  replyToId      String?
  replyTo        Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("MessageReplies")
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([expiresAt])
  @@index([senderId])
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin, map: "Message_content_trgm_idx")
}

model MessageRead {
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, messageId])
}

// Bir kullanıcının sohbet başına son okuma imleci. Her mesaj için MessageRead satırı
// oluşturmak yerine sabit sayıda durum kaydı tutulur.
model ConversationReadState {
  id                String       @id @default(uuid())
  userId            String
  conversationId    String
  lastReadAt        DateTime
  lastReadMessageId String?
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([conversationId, lastReadAt])
}

model MessageStar {
  messageId String
  userId    String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, messageId])
}

model MessageDeletion {
  messageId String
  userId    String
  deletedAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, messageId])
}

model UserDevice {
  id                 String          @id @default(uuid())
  userId             String
  deviceName         String          @default("Web Browser")
  signaturePublicKey String
  historyPublicKey   String?
  credential         String
  lastActiveAt       DateTime        @default(now())
  revokedAt          DateTime?
  approvedAt         DateTime?
  approvedByDeviceId String?
  approvalSignature  String?
  approvedByVault    Boolean         @default(false)
  createdAt          DateTime        @default(now())
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyPackages        MlsKeyPackage[]
  welcomes           MlsWelcome[]
  refreshSessions    RefreshSession[]

  @@unique([userId, signaturePublicKey])
  @@index([userId, revokedAt])
}

model MlsKeyPackage {
  id            String     @id @default(uuid())
  userId        String
  deviceId      String
  keyPackage    String
  keyPackageRef String     @unique
  consumedAt    DateTime?
  createdAt     DateTime   @default(now())
  device        UserDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([deviceId, consumedAt])
}

model MlsCommit {
  id             String       @id @default(uuid())
  conversationId String
  epoch          Int
  senderDeviceId String
  commitData     String
  ratchetTree    String?
  groupInfo      String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, epoch])
  @@index([conversationId, epoch])
}

model MlsWelcome {
  id                String       @id @default(uuid())
  conversationId    String
  epoch             Int
  recipientDeviceId String
  welcomeData       String
  ratchetTree       String?
  deliveredAt       DateTime?
  createdAt         DateTime     @default(now())
  recipientDevice   UserDevice   @relation(fields: [recipientDeviceId], references: [id], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([recipientDeviceId, deliveredAt])
  @@index([conversationId, epoch])
}

model EncryptedHistoryBackup {
  id            String   @id @default(uuid())
  userId        String   @unique
  fileKey       String
  kdfSalt       String
  kdfAlgorithm  String   @default("PBKDF2-SHA256")
  kdfParams     String
  cipherNonce   String
  checksum      String
  backupVersion Int      @default(1)
  sizeBytes     Int
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
