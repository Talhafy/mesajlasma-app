generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String             @id @default(uuid())
  username                  String             @unique
  email                     String             @unique
  password_hash             String
  createdAt                 DateTime           @default(now())
  lastSeenAt                DateTime           @default(now())
  readReceiptsOn            Boolean            @default(true)
  avatarFileKey             String?
  failedLoginAttempts       Int                @default(0)
  messages                  Message[]
  scheduledMessages         ScheduledMessage[]
  participants              Participant[]
  refreshSessions           RefreshSession[]
  administeredConversations Conversation[]     @relation("ConversationAdmin")
  blockedUsers              BlockedUser[]      @relation("BlockedBy")
  blockedByUsers            BlockedUser[]      @relation("Blocks")
  messageReads              MessageRead[]
  messageStars              MessageStar[]
  messageDeletions          MessageDeletion[]
}

model BlockedUser {
  userId    String
  blockedId String
  createdAt DateTime @default(now())
  user      User     @relation("BlockedBy", fields: [userId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocks", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([userId, blockedId])
  @@index([blockedId])
}

model RefreshSession {
  /// Ham refresh token hiçbir zaman veritabanına yazılmaz; yalnızca HMAC özeti tutulur.
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Conversation {
  id                String             @id @default(uuid())
  isGroup           Boolean            @default(false)
  name              String?
  adminId           String?
  avatarFileKey     String?
  createdAt         DateTime           @default(now())
  disappearingDurationSeconds Int?
  admin             User?              @relation("ConversationAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  messages          Message[]
  scheduledMessages ScheduledMessage[]
  participants      Participant[]
  gameChannels      GameChannel[]

  @@index([adminId])
}

model Participant {
  id             String       @id @default(uuid())
  userId         String
  conversationId String
  joinedAt       DateTime     @default(now())
  isPinned       Boolean      @default(false)
  isArchived     Boolean      @default(false)
  isMuted        Boolean      @default(false)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([conversationId])
}

model Message {
  id             String       @id @default(uuid())
  content        String
  senderId       String
  conversationId String
  gameChannelId   String?
  clientId       String?
  createdAt      DateTime     @default(now())
  expiresAt      DateTime?
  editedAt       DateTime?
  reads          MessageRead[]
  stars          MessageStar[]
  deletions      MessageDeletion[]
  isPinned       Boolean      @default(false)
  isForwarded    Boolean      @default(false)
  fileKey        String?
  fileType       String?
  fileName       String?
  replyToId      String?
  replyTo        Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("MessageReplies")
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  gameChannel    GameChannel? @relation(fields: [gameChannelId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([expiresAt])
  @@index([senderId])
  @@index([gameChannelId, createdAt(sort: Desc), id(sort: Desc)])
}

enum GameChannelType {
  TEXT
  VOICE
}

model GameChannel {
  id             String          @id @default(uuid())
  conversationId String
  createdById    String
  name           String
  type           GameChannelType
  position       Int             @default(0)
  maxParticipants Int?
  createdAt      DateTime        @default(now())
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@unique([conversationId, type, name])
  @@index([conversationId, type, position])
  @@index([createdById])
}

model MessageRead {
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, messageId])
}

model ScheduledMessage {
  id             String       @id @default(uuid())
  content        String
  senderId       String
  conversationId String
  clientId       String?
  sendAt         DateTime
  createdAt      DateTime     @default(now())
  fileKey        String?
  fileType       String?
  fileName       String?
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientId])
  @@index([sendAt])
  @@index([conversationId, senderId])
}

model MessageStar {
  messageId String
  userId    String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, messageId])
}

model MessageDeletion {
  messageId String
  userId    String
  deletedAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId, messageId])
}
